# Multimodal EV RAG Assistant - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# News API - Get your free API key from https://newsapi.org/
# Free tier: 100 requests per day, 1000 requests per month
NEWS_API_KEY=your_news_api_key_here

# Pinecone API - Get your API key from https://www.pinecone.io/
# Free tier: 1 index, 100k vectors, serverless
PINECONE_API_KEY=your_pinecone_api_key_here

# OpenRouter API - Get your API key from https://openrouter.ai/
# Pay-as-you-go pricing, multiple models available
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=auto
LLM_MODEL=

# Optional: Configure specific settings if needed
# PINECONE_REGION=us-east-1
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CLIP_MODEL=openai/clip-vit-base-patch32
